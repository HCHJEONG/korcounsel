# KorCounsel server-side environment example.
# Copy to .env (Git-ignored) and replace every CHANGE_ME value.
# Load explicitly: KLEGAL_ENV_FILE=/absolute/path/to/.env
# Never prefix account/password variables with VITE_: they must stay on the server.

# Exactly one administrator and one editor; IDs must be different.
KORCOUNSEL_ADMIN_ID=CHANGE_ME_ADMIN_ID
KORCOUNSEL_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_12_OR_MORE_CHARACTERS
KORCOUNSEL_DEV_EDITOR_ID=CHANGE_ME_EDITOR_ID
KORCOUNSEL_DEV_EDITOR_PASSWORD=CHANGE_ME_EDITOR_PASSWORD_12_OR_MORE_CHARACTERS

# Exact browser origin (no trailing slash).
# Vite: http://127.0.0.1:5173 | local Compose: http://127.0.0.1:8080
# Production: https://korcounsel.com
WEB_ORIGIN=http://127.0.0.1:5173

# Compose API connections use the postgres service host (postgres:5432).
# Local PostgreSQL / persistent data. Use actual absolute paths for the API runtime.
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=CHANGE_ME_DB_USER
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=korcounsel_dev
POSTGRES_PORT=55432
# Host-run API/CLI: DATABASE_URL takes precedence over individual fields.
# Compose API/worker/migrate use the individual fields with postgres:5432.
DATABASE_URL=postgresql://CHANGE_ME_DB_USER:CHANGE_ME_DB_PASSWORD@127.0.0.1:55432/korcounsel_dev
DATA_DIR=/absolute/path/to/korcounsel/data
LEGACY_PARQUET_PATH=/absolute/path/to/korcounsel/data/corrected-parquet-20260911-v1/legacy-corrected-full.parquet
LOG_LEVEL=INFO

# Optional source API configuration. OC is not classified as a secret in this project.
LAW_GO_KR_OC=CHANGE_ME_OC
