# Copy to backend/.env and explicitly set KLEGAL_ENV_FILE; never commit real values.
# Process environment overrides the selected file.
DATABASE_URL=postgresql://korcounsel:korcounsel_local_only@127.0.0.1:55432/korcounsel_dev
LOG_LEVEL=INFO
# DATA_DIR must be absolute; default is repository/data during local development.
# LAW_OPEN_API_OC=your-api-credential
# LAW_GO_KR_OC is an accepted alias; conflicting values are rejected.
# Optional: corrected Parquet snapshot for verification search UI.
LEGACY_PARQUET_PATH=/absolute/path/to/legacy-corrected-full.parquet